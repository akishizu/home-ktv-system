DATABASE_URL=
CONTROLLER_BASE_URL=
MEDIA_ROOT=
PUBLIC_BASE_URL=
CORS_ALLOWED_ORIGINS=
TV_ROOM_SLUG=living-room
# YouTube supplement (yt-dlp, supplement only; NAS library stays primary)
# Set to "false" to disable YouTube search/playback entirely.
YOUTUBE_ENABLED=true
# Path to the yt-dlp binary on the API host. It must be installed there;
# on this VM the durable copy is ~/.local/bin/yt-dlp, which may not be on PATH.
YT_DLP_PATH=yt-dlp
YOUTUBE_SEARCH_LIMIT=10
YOUTUBE_STREAM_CACHE_MS=600000
# How long (ms) to wait for yt-dlp per search/stream call before giving up.
# 20s is the default; raise it only on a host where YouTube is slow but works.
YOUTUBE_TIMEOUT_MS=20000
